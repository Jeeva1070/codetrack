{
  "publisher": "jeevavarshan",
  "name": "gridly",
  "displayName": "%extension.name%",
  "version": "0.1.1",
  "description": "%extension.description%",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeeva1070/codetrack"
  },
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.99.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "gridly.getToken",
        "title": "%command.getToken%"
      },
      {
        "command": "gridly.toDashboard",
        "title": "%command.toDashboard%"
      },
      {
        "command": "gridly.codeTimeInStatusBar",
        "title": "%command.codeTimeInStatusBar%"
      },
      {
        "command": "gridly.viewDashboard",
        "title": "%command.viewDashboard%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "gridly.statusBarInfo": {
          "type": "string",
          "default": "Total",
          "enum": [
            "Total",
            "Today",
            "24h"
          ],
          "enumDescriptions": [
            "%config.statusBarInfo.enum.total%",
            "%config.statusBarInfo.enum.today%",
            "%config.statusBarInfo.enum.24h%"
          ],
          "description": "%config.statusBarInfo.description%"
        },
        "gridly.displayLanguage": {
          "type": "string",
          "default": "Auto",
          "enum": [
            "Auto",
            "zh-CN",
            "en",
            "ja",
            "de",
            "fr",
            "es",
            "it",
            "pt-BR",
            "ru",
            "ko",
            "hi",
            "zh-TW",
            "ur"
          ],
          "enumDescriptions": [
            "%config.displayLanguage.enum.auto%",
            "%config.displayLanguage.enum.zh-cn%",
            "%config.displayLanguage.enum.en%",
            "%config.displayLanguage.enum.ja%",
            "%config.displayLanguage.enum.de%",
            "%config.displayLanguage.enum.fr%",
            "%config.displayLanguage.enum.es%",
            "%config.displayLanguage.enum.it%",
            "%config.displayLanguage.enum.pt-br%",
            "%config.displayLanguage.enum.ru%",
            "%config.displayLanguage.enum.ko%",
            "%config.displayLanguage.enum.hi%",
            "%config.displayLanguage.enum.zh-tw%",
            "%config.displayLanguage.enum.ur%"
          ],
          "description": "%config.displayLanguage.description%"
        },
        "gridly.trackingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.trackingEnabled.description%"
        },
        "gridly.obfuscateFilePaths": {
          "type": "boolean",
          "default": true,
          "description": "%config.obfuscateFilePaths.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "vscode:package": "vsce package --no-dependencies",
    "vscode:publish": "vsce package --no-dependencies && vsce publish",
    "compile": "webpack --devtool nosources-source-map --config ./build/node-extension.webpack.config.js",
    "watch": "webpack --watch --devtool nosources-source-map --config ./build/node-extension.webpack.config.js",
    "package": "webpack --mode production --config ./build/node-extension.webpack.config.js",
    "test-compile": "tsc -p ./tsconfig.test.json",
    "test-watch": "tsc -watch -p ./tsconfig.test.json",
    "lint": "eslint src build --fix",
    "pretest": "pnpm run test-compile && pnpm run lint",
    "test": "mocha out/test/unit/**/*.test.js",
    "test:integration": "node ./out/test/integration/runTest.js",
    "l10n:extract": "vscode-l10n-dev -o ./l10n ./src"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "date-fns": "^4.1.0",
    "os-name": "^6.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.0",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^9.20.0",
    "glob": "^11.0.1",
    "mocha": "^11.1.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  }
}
